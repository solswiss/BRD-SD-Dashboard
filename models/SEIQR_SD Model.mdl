{UTF-8}
Reintroduction rate=DELAY FIXED ( quarantine recovery rate+Recovery Rate , (Immunity waning\
		/3)*(1+BRD Stress), 0 )
	~	cattle/day
	~		|

Exposure Rate=Susceptible*Force of infection
	~	cattle/day
	~		|

Recovered= INTEG ((quarantine recovery rate+Recovery Rate-Reintroduction rate),
		0)
	~	cattle
	~		~	:SUPPLEMENTARY 
	|

Susceptible= INTEG (Reintroduction rate-Exposure Rate,
		init s)
	~	cattle
	~		|

Immunity waning=180
	~	day [0,500]
	~		|

inital stress=0.025
	~	Dmnl [0,1]
	~		|

preconditioning effect=1/(1 + 1.5*preconditioning score)
	~	Dmnl
	~		|

Stress Buildup=(age score
	+ commingling effect
	+ (preconditioning effect)
	+ season stress
	+ transportation stress
	+ weather stress)/6
	~	Dmnl
	~		|

BRD Stress= INTEG (Stress Buildup-Stress Recovery,
		inital stress)
	~	Dmnl
	~		|

transportation stress=((0.9-EXP ( -0.2*("average transit time (hours)") )) + (0.9-EXP\
		 ( -0.003*("average transport distance (miles)")))) /  2
	~	Dmnl [0,1]
	~		|

commingling effect=1 - EXP(-0.15 * contact rate)
	~	Dmnl [0.001,1,0.001]
	~		|

Stress Recovery=BRD Stress/stress adaptation time
	~	Dmnl
	~		|

stress adaptation time=2
	~	Dmnl [0,20]
	~		|

transmission probability=(1+BRD Stress)*(1-vaccination coverage)*infectivity
	~	Dmnl
	~		|

preconditioning score=0.4
	~	Dmnl [0.01,1,0.01]
	~		|

age score=EXP (-0.08*("average age (months)"-5) )
	~	Dmnl [0,1]
	~		|

"average age (months)"=10
	~	Dmnl [5,12,1]
	~		|

"average ambient temperature (F)"=70
	~	Dmnl [-10,120,5]
	~		|

"average humidity (%)"=45
	~	Dmnl [35,90,1]
	~		|

"season (0:winter, 1:summer, 2:spring, 3: fall)"=2
	~	Dmnl [0,3,1]
	~		|

"average transit time (hours)"=5
	~	Dmnl [2,24,1]
	~		|

"average transport distance (miles)"=250
	~	Dmnl [50,1000,1]
	~		|

season stress=0.5 + (0.5* cos (2*3.1415*("season (0:winter, 1:summer, 2:spring, 3: fall)"\
		 - 3 ) / 4))
	~	Dmnl [0,1]
	~		|

weather stress=((ABS ( "average ambient temperature (F)" - 65 )/40 ) + (1-EXP ( -0.02\
		*("average humidity (%)") ) )) / 2
	~	Dmnl [0,1]
	~		|

Infected mortality rate=
	Infected*fractional mortality
	~	cattle/day
	~		|

fractional mortality=0.05
	~	Dmnl [0,1]
	~		|

Force of infection=
	contact rate*transmission probability*(Infected/current population)
	~	1/day
	~		|

infectivity=pathogen load
	~	Dmnl [0,1]
	~		|

current population=
	Exposed+Quarantine+Recovered+Susceptible+Infected
	~	cattle
	~		|

Infection Rate=(1/Incubation period)*(Exposed)
	~	cattle/day
	~		|

Total Deaths=Infected Mortality+Quarantine Deaths
	~	cattle
	~		|

Infected Mortality= INTEG (
	Infected mortality rate,
		0)
	~	cattle
	~		|

Quarantine= INTEG (Quarantine rate-quarantine recovery rate-Quarantine mortality rate\
		,
		0)
	~	cattle
	~		|

quarantine death rate=0.001
	~	1/day [0,1]
	~		|

Quarantine Deaths= INTEG (Quarantine mortality rate,
		0)
	~	cattle
	~		|

Quarantine mortality rate=Quarantine*quarantine death rate
	~	cattle/day
	~		|

Infected= INTEG (Infection Rate-Infected mortality rate-Quarantine rate-Recovery Rate\
		,
		initial infected)
	~	cattle
	~		|

Incubation period=4
	~	day [0,14]
	~		|

pathogen load=0.3
	~	Dmnl [0,1]
	~		|

init s=initial population-initial infected
	~	cattle
	~		|

vaccination coverage=
	0.4
	~	Dmnl [0,1]
	~		|

Exposed= INTEG (Exposure Rate-Infection Rate,
		0)
	~	cattle
	~		|

initial infected=1
	~	cattle [0,?]
	~		|

initial population=10000
	~	cattle [0,?]
	~		|

quarantine recovery rate=Quarantine/average time to recovery in quarantine
	~	cattle/day
	~		|

Recovery Rate=Infected*(1/average infection time)
	~	cattle/day
	~		|

cattle sold=50
	~	head
	~		~	:SUPPLEMENTARY 
	|

contact rate=
	10
	~	1/day [0,50]
	~		|

average time to recovery in quarantine=7
	~	day [0,20]
	~		|

average infection time=7
	~	day [0,20]
	~		|

average time to quarantine=4
	~	day [0,20]
	~		|

Quarantine rate=Infected/average time to quarantine
	~	cattle/day
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 720
	~	day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.125
	~	day [0,?]
	~	The time step for the simulation.
	|

