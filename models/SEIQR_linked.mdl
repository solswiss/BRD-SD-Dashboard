{UTF-8}
ADG reduction loss=
	Infected*(1-ADG reduction rate)
	~	cattle
	~		|

ADG reduction rate=
	0.08
	~	Dmnl [0,0.5]
	~		|

Healthcare cost=
	Vaccination cost+(Unit cost of metaphylactic AMU*Susceptible)+(Unit cost of therapeutic AMU\
		*Infected)
	~	USD
	~		|

AMU Rate=
	fractional AMU rate 1+fractional AMU rate 2
	~	grams/day
	~		|

Production Cost=
	Healthcare cost+Non healthcare cost
	~	USD
	~		|

Profit= INTEG (
	Profitability rate,
		1)
	~	
	~		|

Profitability rate=
	(Herd Revenue-Production Cost)*fractional profitability rate
	~	USD/Year
	~		|

Infected mortality rate=
	Infected*fractional mortality
	~	cattle/day
	~		|

treatment rate=
	((Infected+Quarantine)*treatment dosage)/Usage frequency T
	~	grams/day
	~		|

Unit cost of metaphylactic AMU=
	10
	~	USD [0,50,10]
	~		|

Cumulative antimicrobial usage= INTEG (
	AMU Rate,
		0)
	~	grams
	~		|

unit cost of vaccine=
	10
	~	USD [0,50]
	~		|

Unit non healthcare cost=
	1000
	~	USD/cattle [500,2000,200]
	~		|

loss rate=
	Steer heifer value*(ADG reduction loss+mortality loss)*opportunity cost
	~	
	~		|

Metaphylactic usage= INTEG (
	metaphylaxis rate-fractional AMU rate 1,
		0)
	~	grams
	~		|

Revenue rate=
	Recovered*Steer heifer value
	~	USD
	~		|

fractional AMU rate 1=
	Metaphylactic usage
	~	grams/day
	~		|

fractional AMU rate 2=
	Therapeutic usage
	~	grams/day
	~		|

fractional mortality=
	0.05
	~	Dmnl [0,1]
	~		|

fractional profitability rate=
	1
	~	USD/Year
	~		|

Therapeutic usage= INTEG (
	treatment rate-fractional AMU rate 2,
		0)
	~	grams
	~		|

Herd Revenue= INTEG (
	Revenue rate,
		1)
	~	USD
	~		|

Total Production Loss= INTEG (
	loss rate,
		1)
	~	USD
	~		|

Usage frequency T=
	1
	~	day [0,10,2]
	~		|

metaphylaxis dosage=
	0.1
	~	grams/cattle [0,10]
	~		|

treatment dosage=
	0.1
	~	grams/cattle [0,10]
	~		|

mortality loss=
	Infected Mortality
	~	cattle
	~		|

Non healthcare cost=
	Unit non healthcare cost*current population
	~	USD
	~		|

Unit cost of therapeutic AMU=
	10
	~	USD [0,50,10]
	~		|

Vaccination cost=
	unit cost of vaccine*current population*vaccination coverage
	~	USD
	~		|

metaphylaxis rate=
	(Susceptible*Risk factor score*metaphylaxis dosage)/Usage frequency M
	~	grams/day
	~		|

Usage frequency M=
	1
	~	day [0,10,2]
	~		|

Steer heifer value=
	2500
	~	USD [1000,4000,500]
	~		|

opportunity cost=
	0.1
	~	Dmnl [0,1]
	~	10% opportunity cost
	|

transmission probability=
	Risk factor score*(1-vaccination coverage)*infectivity
	~	
	~		|

Force of infection=
	contact rate*transmission probability*(Infected/current population)
	~	1/day
	~		|

Exposure Rate=
	Susceptible*Force of infection
	~	cattle/day
	~		|

infectivity=pathogen load
	~	Dmnl [0,1]
	~		|

current population=
	Exposed+Quarantine+Recovered+Susceptible+Infected
	~	cattle
	~		|

Risk factor score=(age score+commingling score+preconditioning score+season score+transportation score\
		+weather score
	)/7
	~	Dmnl
	~		|

Infection Rate=(1/Incubation period)*(Exposed)
	~	cattle/day
	~		|

Total Deaths=Infected Mortality+Quarantine Deaths
	~	cattle
	~		|

Infected Mortality= INTEG (
	Infected mortality rate,
		0)
	~	cattle
	~		|

Quarantine= INTEG (Quarantine rate-quarantine recovery rate-Quarantine mortality rate\
		,
		0)
	~	cattle
	~		|

quarantine death rate=0.001
	~	1/day [0,1]
	~		|

Quarantine Deaths= INTEG (Quarantine mortality rate,
		0)
	~	cattle
	~		|

Quarantine mortality rate=Quarantine*quarantine death rate
	~	cattle/day
	~		|

Infected= INTEG (Infection Rate-Infected mortality rate-Quarantine rate-Recovery Rate\
		,
		initial infected)
	~	cattle
	~		|

Incubation period=4
	~	day [0,14]
	~		|

Recovered= INTEG ((quarantine recovery rate+Recovery Rate),
		0)
	~	cattle
	~		~	:SUPPLEMENTARY 
	|

pathogen load=
	0.4
	~	Dmnl [0,1]
	~		|

init s=initial population-initial infected
	~	cattle
	~		|

vaccination coverage=
	0.4
	~	Dmnl [0,1]
	~		|

Exposed= INTEG (Exposure Rate-Infection Rate,
		50)
	~	cattle
	~		|

initial infected=1
	~	cattle [0,?]
	~		|

initial population=10000
	~	cattle [0,?]
	~		|

Susceptible= INTEG (-Exposure Rate,
		init s)
	~	cattle
	~		|

quarantine recovery rate=Quarantine/average time to recovery in quarantine
	~	cattle/day
	~		|

Recovery Rate=Infected*(1/average infection time)
	~	cattle/day
	~		|

preconditioning score=
	1
	~	Dmnl [0,1]
	~		|

cattle sold=50
	~	head
	~		~	:SUPPLEMENTARY 
	|

Days on feed=10
	~	day
	~		~	:SUPPLEMENTARY 
	|

age score=
	1
	~	Dmnl [0,1]
	~		|

season score=
	1
	~	Dmnl [0,1]
	~		|

commingling score=
	1
	~	Dmnl [0,1]
	~		|

weather score=0.5
	~	Dmnl [0,1]
	~		|

contact rate=
	10
	~	1/day [0,50]
	~		|

transportation score=
	1
	~	Dmnl [0,1]
	~		|

average time to recovery in quarantine=7
	~	day [0,20]
	~		|

average infection time=7
	~	day [0,20]
	~		|

average time to quarantine=4
	~	day [0,20]
	~		|

Quarantine rate=Infected/average time to quarantine
	~	cattle/day
	~		|

